{
  "manifest_version": 3,
  "name": "BrowseLog",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "description": "A personal browsing activity tracker with local visit history and idle-aware timing.",
  "permissions": ["tabs", "storage", "idle", "alarms", "webNavigation"],
  "incognito": "not_allowed",
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{
    "matches": ["*://youtube.com/*", "*://*.youtube.com/*"],
    "js": ["player.js"],
    "run_at": "document_idle"
  }],
  "action": {
    "default_title": "Open BrowseLog",
    "default_popup": "popup.html"
  }
}
